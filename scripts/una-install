#!/usr/bin/env bash
# Install .uapp files on a USB-connected UNA Watch (mass-storage drive).
#   una-install [-n NAME] FILE.uapp...   copy to Apps/NAME/ (default: file name up to first "_")
#   una-install -l                       list installed apps
#   una-install -r FILE.uapp...          also reboot the watch over the serial console
# New apps are only picked up at boot. After a reboot with the cable in, the
# drive stays away until the cable is replugged (kernel 1.7.0).
set -euo pipefail

dev="/dev/disk/by-label/UNA\x20WATCH"
name="" list=0 reset=0
while getopts "n:lrh" o; do
  case $o in
    n) name=$OPTARG ;;
    l) list=1 ;;
    r) reset=1 ;;
    *) sed -n '2,7s/^# \?//p' "$0"; exit 1 ;;
  esac
done
shift $((OPTIND - 1))
[ $list = 1 ] || [ $# -gt 0 ] || { sed -n '2,7s/^# \?//p' "$0"; exit 1; }

[ -e "$dev" ] || { echo "UNA WATCH drive not found; is the watch connected and awake?" >&2; exit 1; }

mnt=$(findmnt -n -o TARGET --source "$dev" || true)
mounted_here=0
if [ -z "$mnt" ]; then
  udisksctl mount -b "$dev" >/dev/null
  mnt=$(findmnt -n -o TARGET --source "$dev")
  mounted_here=1
fi
cleanup() {
  sync
  [ $mounted_here = 1 ] && udisksctl unmount -b "$dev" >/dev/null
}
trap cleanup EXIT

if [ $list = 1 ]; then
  find "$mnt/Apps" -mindepth 1 -maxdepth 2 -printf '%P\n' | sort
  exit 0
fi

for f in "$@"; do
  base=$(basename "$f")
  app=${name:-${base%%_*}}
  app=${app%.uapp}
  mkdir -p "$mnt/Apps/$app"
  # one .uapp per app folder: drop older versions
  find "$mnt/Apps/$app" -maxdepth 1 -name '*.uapp' -delete
  cp "$f" "$mnt/Apps/$app/"
  echo "installed $base -> Apps/$app/"
done
if [ $reset = 1 ]; then
  cleanup; trap - EXIT
  "$(dirname "$0")/una-cli" reset
else
  echo "Reboot the watch to load it: una-cli reset, or power-cycle."
fi
