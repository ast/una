#!/usr/bin/env python3
"""Run one command on the UNA Watch USB serial console and print the reply.

  una-cli menu       list the commands
  una-cli reset      reboot the watch (loads newly copied apps)

Do not run this within ~10 s of the watch starting: typing on the port during
that window puts the watch in factory test mode (prompt "una-test>"). Closing
the port makes it restart normally.
"""
import os
import re
import select
import sys
import termios
import time

PORT = os.environ.get("UNA_PORT", "/dev/una-watch")


def read(fd, seconds):
    buf = b""
    end = time.time() + seconds
    while time.time() < end:
        if select.select([fd], [], [], 0.1)[0]:
            try:
                buf += os.read(fd, 4096)
            except OSError:  # the port goes away on reset
                break
    return re.sub(rb"\x1b\[[0-9;]*[A-Za-z]", b"", buf).decode("utf-8", "replace")


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        sys.exit(__doc__)
    try:
        fd = os.open(PORT, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
    except OSError as e:
        sys.exit(f"{PORT}: {e.strerror}")
    attr = termios.tcgetattr(fd)
    attr[0] = attr[1] = attr[3] = 0  # raw, no echo
    attr[2] = termios.CS8 | termios.CREAD | termios.CLOCAL
    termios.tcsetattr(fd, termios.TCSANOW, attr)

    # The console starts when the port opens; the tty may have echoed its
    # banner back before echo was switched off. An empty line clears that.
    read(fd, 1.5)
    os.write(fd, b"\n")
    banner = read(fd, 0.5)
    if "una-test>" in banner:
        os.close(fd)
        sys.exit("watch is in factory test mode; it restarts now that the port is closed")

    os.sync()  # reset drops the drive without an eject
    os.write(fd, " ".join(sys.argv[1:]).encode() + b"\n")  # commands end in LF
    reply = read(fd, 2.0)
    os.close(fd)
    lines = [l for l in reply.replace("\r", "").split("\n") if l.strip() and l.strip() != "una>"]
    print("\n".join(lines[1:] if lines and lines[0].endswith(sys.argv[1:][-1]) else lines))


if __name__ == "__main__":
    main()
