#!/usr/bin/env bash
# Build the UNA Watch kernel with headless STM32CubeIDE in upstream's Docker
# image (see refs/una-kernel-public/README.md). Output lands in <kernel>/Exe/.
#   una-build-kernel [KERNEL_DIR]      default: kernel/ (working clone)
#   BUILD_VERSION=1.2.3 una-build-kernel
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
kernel=$(cd "${1:-$root/kernel}" && pwd)
proj=Software/App/UnaWatch-CubeIDE

# the build rewrites these; upstream says to restore them before building again
git -C "$kernel" checkout -- "$proj/.settings" "$proj/.project"

docker run --rm -v "$kernel:/workspace" \
  ${BUILD_VERSION:+-e BUILD_VERSION="$BUILD_VERSION"} \
  xanderhendriks/stm32cubeide:16.0 bash -c \
  "apt-get update && apt-get install -y git && \
   git config --global --add safe.directory /workspace && \
   git config --global --add safe.directory /workspace/SDK && \
   . /workspace/SDK/Utilities/Scripts/build-cube/find-cube.sh && \
   . /workspace/SDK/Utilities/Scripts/build-cube/una-version.sh /workspace/$proj/ && \
   /workspace/SDK/Utilities/Scripts/build-cube/build-cube.sh /workspace/$proj/ && \
   chown -R $(id -u):$(id -g) /workspace/Exe /workspace/$proj"

ls -l "$kernel/Exe"
