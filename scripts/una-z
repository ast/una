#!/usr/bin/env python3
"""Drive the UNA Watch running Zephyr over USB, or the simulator.

  una-z sh [-t SECONDS] COMMAND...
                             run a shell command, print its output
  una-z shot [--round] [FILE.png]
                             screenshot (default: build/shot.png); --round cuts it
                             to the round screen, with a thin rim, for showing
  una-z press N [MS]         press button SW1-SW4 for MS milliseconds (default 100)
  una-z flash [FILE.bin]     upload a signed image, boot it as a test, confirm it
                             if it comes up; MCUboot reverts it otherwise
  una-z log [SECONDS]        print what the shell port outputs (log messages) for
                             SECONDS (default 5)
  una-z logs [DIR]           copy the log files kept on the eMMC (telemetry, one
                             line a minute) to DIR (default: logs/)
  una-z runs [DIR]           copy the recorded activities (FIT files) to DIR
                             (default: runs/)
  una-z ppg [DIR]            copy what was written of the heart-rate sensor
                             (/Log/PPG on the eMMC) to DIR (default: logs/ppg/)
  una-z time                 set the watch's clock and UTC offset from this computer
  una-z wait                 wait until the shell answers
  una-z reset                reboot through mcumgr (works when the shell is stuck)

  una-z sim [--window]       start the simulator (build/sim, see the README), again
                             if it is running; --window shows its screen
  una-z sim stop
  una-z -s COMMAND...        sh, shot, press, log, runs, time and wait, on the
                             simulator

The first USB serial port is the shell, the second is mcumgr.
"""
import base64
import glob
import os
import re
import select
import shutil
import subprocess
import sys
import termios
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PROMPT = "una:~$ "
SIGNED = os.path.join(ROOT, "build/zephyr/app/zephyr/zephyr.signed.bin")


SIM = False
SIM_DIR = os.path.join(ROOT, "build/sim")


def port(interface):
    if SIM:
        try:
            return open(os.path.join(SIM_DIR, "pty")).read().strip() if interface == 0 else None
        except OSError:
            return None
    found = glob.glob(f"/dev/serial/by-id/usb-UNA_UNA_Watch_Zephyr_*-if{interface:02d}")
    return found[0] if found else None


def shell(command, timeout=5.0):
    """Send one line to the shell and return what it prints before the next prompt."""
    path = port(0)
    if not path:
        raise OSError("simulator not running (una-z sim)" if SIM else
                      "watch not found (is Zephyr running and the cable in?)")
    fd = os.open(path, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
    try:
        attr = termios.tcgetattr(fd)
        attr[0] = attr[1] = attr[3] = 0  # raw, no echo
        attr[2] = termios.CS8 | termios.CREAD | termios.CLOCAL
        termios.tcsetattr(fd, termios.TCSANOW, attr)

        def read_until(done, seconds):
            buf = b""
            end = time.time() + seconds
            while time.time() < end and not done(buf):
                if select.select([fd], [], [], 0.05)[0]:
                    buf += os.read(fd, 65536)
            return buf

        def quiet(seconds):
            while select.select([fd], [], [], seconds)[0]:
                os.read(fd, 65536)

        # An empty line first, and wait for the port to go quiet: that leaves
        # a clean prompt whatever was typed or logged before.
        os.write(fd, b"\n")
        quiet(0.2)
        os.write(fd, command.encode() + b"\n")
        # Done at the first prompt after the echo of the command.
        echo, prompt = command.encode(), PROMPT.encode()
        raw = read_until(lambda b: echo in b and prompt in b[b.index(echo):], timeout)
    finally:
        os.close(fd)
    text = re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", raw.decode("utf-8", "replace")).replace("\r", "")
    if command not in text or PROMPT not in text[text.index(command):]:
        raise TimeoutError(f"no prompt after {command!r}:\n{text}")
    text = text[text.index(command) + len(command):]
    return text[: text.index(PROMPT)].strip("\n")


def log(seconds):
    """Print whatever arrives on the shell port, without sending anything."""
    fd = os.open(port(0), os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
    try:
        attr = termios.tcgetattr(fd)
        attr[0] = attr[1] = attr[3] = 0
        attr[2] = termios.CS8 | termios.CREAD | termios.CLOCAL
        termios.tcsetattr(fd, termios.TCSANOW, attr)
        end = time.time() + seconds
        while time.time() < end:
            if select.select([fd], [], [], 0.1)[0]:
                text = os.read(fd, 65536).decode("utf-8", "replace")
                sys.stdout.write(re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", text).replace("\r", ""))
                sys.stdout.flush()
    finally:
        os.close(fd)


def wait(seconds=30.0):
    end = time.time() + seconds
    while time.time() < end:
        try:
            return shell("kernel uptime", 2.0)
        except (OSError, TimeoutError):
            time.sleep(0.5)
    sys.exit(f"the shell did not answer within {seconds:.0f} s")


def round_screen(img):
    """The panel is square in memory and round behind the bezel: keep the circle."""
    from PIL import Image, ImageDraw

    n, scale = img.width, 4
    big = n * scale
    mask = Image.new("L", (big, big), 0)
    ImageDraw.Draw(mask).ellipse((0, 0, big - 1, big - 1), fill=255)
    rim = Image.new("L", (big, big), 0)
    ImageDraw.Draw(rim).ellipse((0, 0, big - 1, big - 1), outline=255, width=2 * scale)
    out = img.convert("RGBA")
    out.paste((64, 64, 64, 255), mask=rim.resize((n, n), Image.LANCZOS))
    out.putalpha(mask.resize((n, n), Image.LANCZOS))
    return out


def shot(out, rounded=False):
    from PIL import Image

    lines = shell("screenshot", 20.0).split("\n")
    start = next(i for i, l in enumerate(lines) if l.startswith("SCREENSHOT "))
    _, width, height, fmt = lines[start].split()
    width, height = int(width), int(height)
    rows = lines[start + 1 : start + 1 + height]
    if fmt != "RGB565LE" or len(rows) != height or lines[start + 1 + height] != "END":
        sys.exit("screenshot: unexpected reply")
    img = Image.new("RGB", (width, height))
    px = img.load()
    for y, row in enumerate(rows):
        data = base64.b64decode(row)
        for x in range(width):
            v = data[2 * x] | data[2 * x + 1] << 8
            px[x, y] = ((v >> 11) * 255 // 31, ((v >> 5) & 63) * 255 // 63, (v & 31) * 255 // 31)
    os.makedirs(os.path.dirname(os.path.abspath(out)), exist_ok=True)
    if rounded:
        img = round_screen(img)
    img.save(out)
    print(out)


def press(n, ms):
    code = 1 + n  # INPUT_KEY_1 is 2
    shell(f"input report 1 {code} 1")
    time.sleep(ms / 1000)
    shell(f"input report 1 {code} 0")


def smpmgr(*args):
    cmd = ["smpmgr", "--port", port(2), "--timeout", "5", *args]
    return subprocess.run(cmd, check=True, capture_output=True, text=True).stdout


def flash(path):
    if not port(2):
        sys.exit("mcumgr port not found")
    print("uploading...")
    smpmgr("image", "upload", "--slot", "1", path)
    slots = re.findall(r"slot=(\d+).*?HashBytes\(\s*'([0-9A-F]+)'", smpmgr("image", "state-read"), re.S)
    new = dict(slots).get("1")
    if not new:
        sys.exit("upload did not land in the second slot")
    if dict(slots).get("0") == new:
        sys.exit("that image is already running")
    smpmgr("image", "state-write", new)  # boot it once, as a test
    try:
        shell("kernel reboot cold", 1.0)
    except (OSError, TimeoutError):
        pass
    time.sleep(2)
    print("waiting for the new image...")
    wait(90.0)
    state = shell("mcuboot")
    if re.search(r"^swap type:\s*revert", state, re.M):
        shell("mcuboot confirm")
        print("new image is running and confirmed")
    else:
        print(state)
        sys.exit("the previous image is running: the new one did not boot and was reverted")


LOG_DIR = "/USER:/Log/Zephyr"
ACTIVITY_DIR = "/USER:/Activity"
PPG_DIR = "/USER:/Log/PPG"


def logs(dest):
    os.makedirs(dest, exist_ok=True)
    names = [l.split()[-1] for l in shell(f"fs ls {LOG_DIR}").split("\n") if l.split()[-1:] and
             l.split()[-1].startswith("log.")]
    for name in sorted(names):
        smpmgr("file", "download", f"{LOG_DIR}/{name}", os.path.join(dest, name))
        print(os.path.join(dest, name), os.path.getsize(os.path.join(dest, name)), "bytes")


def ppg(dest):
    os.makedirs(dest, exist_ok=True)
    names = [l.split()[-1] for l in shell(f"fs ls {PPG_DIR}").split("\n") if l.split()[-1:] and
             l.split()[-1].endswith(".txt")]
    for name in sorted(names):
        out = os.path.join(dest, name)
        if not os.path.exists(out):
            smpmgr("file", "download", f"{PPG_DIR}/{name}", out)
        print(out, os.path.getsize(out), "bytes")


def runs(dest):
    """Recorded activities are FIT files in /Activity/YYYYMM/ on the user volume."""
    os.makedirs(dest, exist_ok=True)
    if SIM:
        # The simulator's user volume is a directory here.
        for path in sorted(glob.glob(os.path.join(SIM_DIR, "user/Activity/*/*.fit"))):
            shutil.copy(path, dest)
            print(os.path.join(dest, os.path.basename(path)))
        return
    def names(path):
        return [l.split()[-1].rstrip("/") for l in shell(f"fs ls {path}").split("\n")
                if l.split()[-1:]]
    for month in sorted(n for n in names(ACTIVITY_DIR) if n.isdigit()):
        for name in sorted(n for n in names(f"{ACTIVITY_DIR}/{month}") if n.endswith(".fit")):
            out = os.path.join(dest, name)
            if not os.path.exists(out):
                smpmgr("file", "download", f"{ACTIVITY_DIR}/{month}/{name}", out)
            print(out, os.path.getsize(out), "bytes")


def sim_stop():
    try:
        pid = int(open(os.path.join(SIM_DIR, "pid")).read())
        # Only if that process still is the simulator.
        if "zephyr.exe" in open(f"/proc/{pid}/cmdline").read():
            os.kill(pid, 15)
    except (OSError, ValueError):
        pass
    for name in ("pid", "pty"):
        try:
            os.remove(os.path.join(SIM_DIR, name))
        except OSError:
            pass


def sim_start(window):
    """The simulator's shell is a pseudo-terminal; its path is kept in build/sim/pty."""
    exe = os.path.join(SIM_DIR, "zephyr/zephyr.exe")
    if not os.path.exists(exe):
        sys.exit("no simulator build: west build -b native_sim/native/64 -d build/sim zephyr/una/app")
    sim_stop()
    env = dict(os.environ)
    # SDL comes from the build environment; a library path from elsewhere breaks it.
    env.pop("LD_LIBRARY_PATH", None)
    if not window:
        env["SDL_VIDEODRIVER"] = "dummy"
    log_path = os.path.join(SIM_DIR, "sim.log")
    with open(log_path, "w") as out:
        # Settings are kept in flash.bin, as the watch keeps them in its flash.
        # and the user volume is a directory.
        os.makedirs(os.path.join(SIM_DIR, "user"), exist_ok=True)
        proc = subprocess.Popen([exe, "-flash=" + os.path.join(SIM_DIR, "flash.bin"),
                                 "-volume=" + os.path.join(SIM_DIR, "user") + ":/USER"],
                                stdin=subprocess.DEVNULL, stdout=out, stderr=out, env=env,
                                start_new_session=True)
    end = time.time() + 10
    while time.time() < end:
        found = re.search(r"connected to pseudotty: (\S+)", open(log_path).read())
        if found:
            break
        if proc.poll() is not None:
            sys.exit("the simulator stopped:\n" + open(log_path).read())
        time.sleep(0.05)
    else:
        sys.exit("the simulator did not open its shell:\n" + open(log_path).read())
    with open(os.path.join(SIM_DIR, "pid"), "w") as f:
        f.write(str(proc.pid))
    with open(os.path.join(SIM_DIR, "pty"), "w") as f:
        f.write(found.group(1))
    wait(10.0)
    set_time()


def set_time():
    offset_min = time.localtime().tm_gmtoff // 60
    print(shell(f"clock set {int(time.time())} {offset_min}"))


def main():
    global SIM
    args = sys.argv[1:]
    if args[:1] == ["-s"]:
        SIM, args = True, args[1:]
    if not args or args[0] in ("-h", "--help"):
        sys.exit(__doc__)
    cmd, rest = args[0], args[1:]
    if cmd == "sim":
        SIM = True
        if rest == ["stop"]:
            sim_stop()
        elif rest in ([], ["--window"]):
            sim_start(bool(rest))
        else:
            sys.exit(__doc__)
        return
    if SIM and cmd not in ("sh", "shot", "press", "log", "runs", "time", "wait"):
        sys.exit(f"{cmd}: not on the simulator")
    try:
        if cmd == "sh":
            timeout = 5.0
            if rest[:1] == ["-t"]:
                timeout, rest = float(rest[1]), rest[2:]
            print(shell(" ".join(rest), timeout))
        elif cmd == "shot":
            rounded = rest[:1] == ["--round"]
            rest = rest[1:] if rounded else rest
            shot(rest[0] if rest else os.path.join(ROOT, "build/sim-shot.png" if SIM else "build/shot.png"),
                 rounded)
        elif cmd == "press":
            press(int(rest[0]), int(rest[1]) if len(rest) > 1 else 100)
        elif cmd == "flash":
            flash(rest[0] if rest else SIGNED)
        elif cmd == "log":
            log(float(rest[0]) if rest else 5.0)
        elif cmd == "reset":
            smpmgr("os", "reset")
        elif cmd == "runs":
            runs(rest[0] if rest else os.path.join(ROOT, "runs"))
        elif cmd == "ppg":
            ppg(rest[0] if rest else os.path.join(ROOT, "logs/ppg"))
        elif cmd == "logs":
            logs(rest[0] if rest else os.path.join(ROOT, "logs"))
        elif cmd == "time":
            set_time()
        elif cmd == "wait":
            print(wait())
        else:
            sys.exit(__doc__)
    except (OSError, TimeoutError) as e:
        sys.exit(str(e))


if __name__ == "__main__":
    main()
