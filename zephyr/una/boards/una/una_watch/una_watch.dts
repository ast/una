/*
 * UNA Watch (UNAcore Rev3.2), STM32U5A5QJI6Q.
 *
 * Pins and clocks follow the stock kernel: main.h and
 * Libs/Source/Drivers/STM32U5xx/System.cpp in una-kernel-public.
 */

/dts-v1/;
#include <st/u5/stm32u5a5Xj.dtsi>
#include <st/u5/stm32u5a5qjixq-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	model = "UNA Watch";
	compatible = "una,una-watch";

	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,uart-mcumgr = &cdc_acm_uart1;
		zephyr,display = &lcd;
		zephyr,bt-hci = &hci_spi;
		/* Runs from the LSE through Stop 2; LPTIM1 and LPTIM3 belong to the LCD. */
		zephyr,system-timer = &lptim4;
	};

	aliases {
		sw0 = &button_sw1;
		/* Held at reset: MCUboot stays in serial recovery. */
		mcuboot-button0 = &button_sw1;
		backlight = &backlight;
		watchdog0 = &iwdg;
		fuel-gauge0 = &fuel_gauge;
		gnss = &gnss;
		rtc = &rtc;
	};

	buttons: gpio_keys {
		compatible = "gpio-keys";

		/* SW1-SW4 in the stock kernel's order (HWButtons::config). */
		button_sw1: button_sw1 {
			label = "SW1";
			gpios = <&gpiod 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_1>;
		};

		/* Also the PMIC's ON key: held long enough it power-cycles the watch. */
		button_sw2: button_sw2 {
			label = "SW2 (power)";
			gpios = <&gpiod 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_2>;
		};

		button_sw3: button_sw3 {
			label = "SW3";
			gpios = <&gpioa 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_3>;
		};

		button_sw4: button_sw4 {
			label = "SW4";
			gpios = <&gpiod 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_4>;
		};
	};

	/*
	 * A-D when a button is released early, W-Z once it has been held, in
	 * the order UP (SW1), SELECT (SW2), DOWN (SW3), BACK (SW4). No input
	 * device is named, so presses simulated from the shell count too.
	 */
	longpress {
		compatible = "zephyr,input-longpress";
		input-codes = <INPUT_KEY_1 INPUT_KEY_2 INPUT_KEY_3 INPUT_KEY_4>;
		short-codes = <INPUT_KEY_A INPUT_KEY_B INPUT_KEY_C INPUT_KEY_D>;
		long-codes = <INPUT_KEY_W INPUT_KEY_X INPUT_KEY_Y INPUT_KEY_Z>;
		long-delay-ms = <700>;
	};

	lcd: lcd {
		compatible = "sharp,ls012b7dd06a";
		width = <240>;
		height = <240>;
		rotated;
		vst-gpios = <&gpiob 10 GPIO_ACTIVE_HIGH>;
		vck-gpios = <&gpioa 4 GPIO_ACTIVE_HIGH>;
		enb-gpios = <&gpioa 7 GPIO_ACTIVE_HIGH>;
		xrst-gpios = <&gpiob 1 GPIO_ACTIVE_HIGH>;
		hst-gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>;
		hck-gpios = <&gpioa 6 GPIO_ACTIVE_HIGH>;
		rgb-gpios = <&gpioe 0 GPIO_ACTIVE_HIGH>, <&gpioe 8 GPIO_ACTIVE_HIGH>,
			    <&gpioe 2 GPIO_ACTIVE_HIGH>, <&gpioe 10 GPIO_ACTIVE_HIGH>,
			    <&gpioe 4 GPIO_ACTIVE_HIGH>, <&gpioe 12 GPIO_ACTIVE_HIGH>;
		/* FRP and XFRP */
		pinctrl-0 = <&lptim1_ch1_pb2 &lptim3_ch1_pd14>;
		pinctrl-names = "default";
	};

	/*
	 * The eMMC as the stock firmware and the UNA bootloader divide it. The
	 * first 100 MiB are the bootloader's own volume ("UNA BOOT": update
	 * files, factory image, GNSS firmware) and are deliberately not
	 * reachable from here; the next two regions are unused by Zephyr.
	 */
	user_disk: user-disk {
		compatible = "una,disk-region";
		disk-name = "USER";
		parent-disk = "MMC";
		start-sector = <614400>;
	};

	/* Buzzer and vibration motor, driven by the app's src/alert_hw.c. */
	zephyr,user {
		/* 4 kHz, the stock firmware's default pitch. */
		pwms = <&buzzer_pwm 3 PWM_USEC(250) PWM_POLARITY_NORMAL>;
		/* BUZZER_EN1 and BUZZER_EN2: together they set the level. */
		buzzer-en-gpios = <&gpiob 9 GPIO_ACTIVE_HIGH>, <&gpiod 5 GPIO_ACTIVE_HIGH>;
		/* DRV2625 NRST: low is shutdown. */
		haptic-enable-gpios = <&gpiof 2 GPIO_ACTIVE_HIGH>;
		/* ALTIMETER_EN: the barometer's supply. */
		baro-en-gpios = <&gpiog 0 GPIO_ACTIVE_HIGH>;
	};

	leds {
		compatible = "gpio-leds";

		backlight: backlight {
			label = "Backlight";
			gpios = <&gpiof 3 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;
		};
	};
};

&pwr {
	power-supply = "smps";
};

/* 16 MHz crystal, the reference of the USB HS PHY. */
&clk_hse {
	clock-frequency = <DT_FREQ_M(16)>;
	status = "okay";
};

/* SiT1532 oscillator, not a crystal. */
&clk_lse {
	lse-bypass;
	status = "okay";
};

&clk_lsi {
	status = "okay";
};

&clk_msis {
	msi-range = <0>; /* 48 MHz */
	status = "okay";
};

&pll1 {
	div-m = <3>;
	mul-n = <10>;
	div-q = <2>; /* 80 MHz, eMMC */
	div-r = <1>; /* 160 MHz */
	clocks = <&clk_msis>;
	status = "okay";
};

&rcc {
	clocks = <&pll1>;
	clock-frequency = <DT_FREQ_M(160)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
	apb3-prescaler = <1>;
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/*
		 * The first 384 KB are the way back to the stock firmware and
		 * cannot be restored without SWD. Never write them.
		 */
		una_boot_partition: partition@0 {
			label = "una-bootloader";
			reg = <0x00000000 DT_SIZE_K(160)>;
			read-only;
		};

		una_libc_partition: partition@28000 {
			label = "una-libc";
			reg = <0x00028000 DT_SIZE_K(224)>;
			read-only;
		};

		/*
		 * The rest is what the stock bootloader calls the kernel: it
		 * starts whatever is at 0x08060000, which here is MCUboot.
		 */
		boot_partition: partition@60000 {
			label = "mcuboot";
			reg = <0x00060000 DT_SIZE_K(128)>;
		};

		slot0_partition: partition@80000 {
			label = "image-0";
			reg = <0x00080000 DT_SIZE_K(1536)>;
		};

		/* Starts at the second flash bank. */
		slot1_partition: partition@200000 {
			label = "image-1";
			reg = <0x00200000 DT_SIZE_K(1536)>;
		};

		storage_partition: partition@380000 {
			label = "storage";
			reg = <0x00380000 DT_SIZE_K(512)>;
		};
	};
};

zephyr_udc0: &usbotg_hs {
	pinctrl-0 = <&usb_otg_hs_dm_pa11 &usb_otg_hs_dp_pa12>;
	pinctrl-names = "default";
	status = "okay";

	/* Shell and log. */
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};

	/* mcumgr (SMP): image upload, in the application and in MCUboot. */
	cdc_acm_uart1: cdc_acm_uart1 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

&otghs_phy {
	status = "okay";
};

/*
 * The barometer's bus: MS5837-02BA at 0x76. The app drives the sensor itself
 * (src/baro_hw.c), as its supply is switched. The heart-rate sensor is on
 * this bus too (PAH8316, 0x40), unpowered so far.
 */
&i2c2 {
	pinctrl-0 = <&i2c2_scl_pb13 &i2c2_sda_pb14>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
	status = "okay";
};

/*
 * The motion sensors' bus: BMI270 at 0x68 and the magnetometer, BMM350, at
 * 0x14. Both have their supply whenever the watch has, and sleep at a few
 * microamps when nothing is asked of them. Both are started by the app, not
 * at boot.
 */
&i2c4 {
	pinctrl-0 = <&i2c4_scl_pd12 &i2c4_sda_pd13>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
	status = "okay";

	/*
	 * Started by the app (src/motion_hw.c), not at boot. Its INT2 is the
	 * one wired. It lies turned a quarter in the watch: the mounting and
	 * the angles of the wrist are the stock firmware's.
	 */
	imu: bmi270@68 {
		compatible = "una,bmi270";
		reg = <0x68>;
		irq-gpios = <&gpioa 1 GPIO_ACTIVE_HIGH>;
		int-pin = <2>;
		axes = <1 0 2>;
		axes-inverted = <1 0 0>;
		wrist-wake-params = <1024 1774 1024 700 179 1925>;
		zephyr,deferred-init;
	};

	/*
	 * src/compass_hw.c. Its interrupt (PC2) is not used. The mounting is
	 * the stock firmware's, measured on the watch.
	 */
	magnetometer: bmm350@14 {
		compatible = "una,bmm350";
		reg = <0x14>;
		axes = <1 0 2>;
		axes-inverted = <0 0 1>;
		zephyr,deferred-init;
	};
};

/*
 * Main bus: PMIC 0x61, fuel gauge 0x36, USB-C sink 0x29, haptic driver 0x5a,
 * display board EEPROM 0x50. Pulled up on the board.
 */
&i2c1 {
	pinctrl-0 = <&i2c1_scl_pb6 &i2c1_sda_pb7>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
	status = "okay";

	/* 200 mAh cell charged to 4.40 V; values as the stock kernel sets them. */
	fuel_gauge: max17262@36 {
		compatible = "maxim,max17262";
		reg = <0x36>;
		design-voltage = <3800>;
		desired-voltage = <4400>;
		desired-charging-current = <150>;
		design-cap = <200>;
		empty-voltage = <3400>;
		recovery-voltage = <3960>;
		charge-voltage = <4400>;
	};
};

/*
 * BLE module (UNAlink_BLUENRG2). The BlueNRG-234N boots with ST's own host
 * stack; req-ll-only tells it to act as a plain controller for this session,
 * which carries data from ST's firmware 3.4.0 on.
 */
&spi1 {
	pinctrl-0 = <&spi1_sck_pg2 &spi1_miso_pg3 &spi1_mosi_pb5>;
	pinctrl-names = "default";
	cs-gpios = <&gpioa 15 GPIO_ACTIVE_LOW>;
	status = "okay";

	hci_spi: bluenrg-2@0 {
		compatible = "st,hci-spi-v2";
		reg = <0>;
		reset-gpios = <&gpioa 8 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;
		irq-gpios = <&gpioa 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		spi-cpha;
		spi-hold-cs;
		spi-max-frequency = <DT_FREQ_M(1)>;
		reset-event;
		req-ll-only;
		reset-assert-duration-ms = <6>;
	};
};

/*
 * Power enables of parts nothing drives yet, held off as the stock kernel
 * boots them. Left floating, the GNSS module's own pull-up turns it on.
 */
&gpiog {
	vled-en-hog {
		gpio-hog;
		gpios = <10 GPIO_ACTIVE_HIGH>;
		output-low;
	};
};

&gpiof {
	ppg-en-hog {
		gpio-hog;
		gpios = <13 GPIO_ACTIVE_HIGH>;
		output-low;
	};
};

&gpiob {
	/* USB_DAM: high hides USB when a debug accessory is attached. */
	usb-dam-hog {
		gpio-hog;
		gpios = <15 GPIO_ACTIVE_HIGH>;
		output-low;
	};
};

/* 4 GB eMMC; its supply is switched by EMMC_EN. */
&sdmmc1 {
	pinctrl-0 = <&sdmmc1_d0_pc8 &sdmmc1_d1_pc9 &sdmmc1_d2_pc10 &sdmmc1_d3_pc11
		     &sdmmc1_ck_pc12 &sdmmc1_cmd_pd2>;
	pinctrl-names = "default";
	clocks = <&rcc STM32_CLOCK(AHB2, 27)>,
		 <&rcc STM32_SRC_HSI48 SDMMC_SEL(0)>;
	pwr-gpios = <&gpiod 10 GPIO_ACTIVE_HIGH>;
	bus-width = <4>;
	/* 48 MHz / (2 * 1) = 24 MHz. Undivided, reads overrun the receive FIFO. */
	clk-div = <1>;
	disk-name = "MMC";
	status = "okay";
};

&timers4 {
	st,prescaler = <0>;
	status = "okay";

	buzzer_pwm: pwm {
		pinctrl-0 = <&tim4_ch3_pb8>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&clk_hsi48 {
	status = "okay";
};

&lptim4 {
	clocks = <&rcc STM32_CLOCK(APB3, 13)>,
		 <&rcc STM32_SRC_LSE LPTIM34_SEL(3)>;
	status = "okay";
};

&rtc {
	clocks = <&rcc STM32_CLOCK(APB3, 21)>,
		 <&rcc STM32_SRC_LSE RTC_SEL(1)>;
	status = "okay";
};

&iwdg {
	status = "okay";
};

/*
 * GNSS: Airoha AG3335M at 921600 baud, as the stock firmware has it. PG5
 * (SENSOR2_RST_L in the stock source) is its power.
 */
&lpuart1 {
	pinctrl-0 = <&lpuart1_tx_pa2 &lpuart1_rx_pa3>;
	pinctrl-names = "default";
	current-speed = <921600>;
	status = "okay";

	gnss: gnss {
		compatible = "airoha,ag3335m";
		enable-gpios = <&gpiog 5 GPIO_ACTIVE_HIGH>;
	};
};
