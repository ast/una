CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

# The stock UNA bootloader stays in flash and starts us at 0x08060000 with
# its own clocks, interrupts and peripherals still set up.
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_INIT_ARCH_HW_AT_BOOT=y

# Console and shell are on the USB CDC-ACM port; there is no UART to reach
# without a debug adapter.
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_UART_LINE_CTRL=y
CONFIG_USB_DEVICE_STACK_NEXT=y
CONFIG_CDC_ACM_SERIAL_INITIALIZE_AT_BOOT=y
CONFIG_CDC_ACM_SERIAL_MANUFACTURER_STRING="UNA"
CONFIG_CDC_ACM_SERIAL_PRODUCT_STRING="UNA Watch Zephyr"
