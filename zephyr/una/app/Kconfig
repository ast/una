config UNA_BNRG_UPDATE
	bool "Load the radio chip's firmware instead of running the radio"
	depends on BOARD_UNA_WATCH
	help
	  Builds the watch without Bluetooth and with ST's firmware image for
	  the BlueNRG-2N inside, which the shell command "bnrg update" writes
	  into the chip. See bnrg-update.conf.

config UNA_BNRG_FW
	string "ST's firmware image for the radio chip"
	depends on UNA_BNRG_UPDATE
	default "../../../firmware/ble/BlueNRG_2N_FW_V3_4_0.bin"
	help
	  BlueNRG_2N_FW_V3_4_0.bin from fw_images/ in ST's STSW-BNRG2N, by its
	  path from the application's folder or in full.

config UNA_HR_RAW_RECORDED
	bool "Keep the heart-rate sensor's samples of every recording"
	default y
	help
	  While an activity is recorded, what the sensor and the accelerometer
	  gave is written to /USER:/Log/PPG/ as "hr raw on" writes it, about
	  1 MB an hour, for scripts/hr-replay: the pulse while running is not
	  right yet, and this is what there is to work on it with. To be turned
	  off when it is.

config UNA_PIXART_REF
	bool "PixArt's closed library on the heart-rate sensor, with the bus traced"
	depends on BOARD_UNA_WATCH && FPU && FP_HARDABI
	help
	  For working out the PAH8316's registers and for a pulse to hold our
	  own against: the shell command "hrref" runs PixArt's driver and
	  algorithm and writes what they do to /USER:/Log/PPG/. The library is
	  PixArt's and not ours to pass on; it is linked from where
	  UNA_PIXART_DIR says and never copied. See hr-ref.conf.

config UNA_PIXART_DIR
	string "The stock kernel's VendorLib folder"
	depends on UNA_PIXART_REF
	default "../../../refs/una-kernel-public/Software/ThirdParty/VendorLib"
	help
	  The folder with lib/libuna_vendor.a and include/pixart/, by its path
	  from the application's folder or in full.

source "Kconfig.zephyr"
